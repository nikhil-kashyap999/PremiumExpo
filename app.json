{
  "expo": {
    "name": "Premium",
    "slug": "myapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.nikhil.premium"
    },
    "android": {
      "package": "com.nikhil.premium",
      "adaptiveIcon": {
        "backgroundColor": "#4498F9",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000",
          "image": "./assets/adaptive-icon.png",
          "imageWidth":200
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "27f2bfb6-acbb-4318-9f51-c3aa512830f5"
      }
    }
  }
}
